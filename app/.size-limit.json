  },
  {
    "name": "Initial JS (today route, gzip)",
    "path": [
      "dist/assets/index-*.js",
      "dist/assets/_plugin-vue_export-helper-*.js",
      "dist/assets/TodayView-*.js",
      "dist/assets/Icon-*.js",
      "dist/assets/juz-*.js",
