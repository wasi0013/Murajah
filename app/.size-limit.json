      "dist/assets/SegmentedControl-*.js",
      "dist/assets/BottomSheet-*.js",
      "dist/assets/data-*.js",
      "dist/assets/useProgressPersistence-*.js",
      "dist/assets/mistakes-*.js",
      "dist/assets/useMistakesPersistence-*.js"
    ],
