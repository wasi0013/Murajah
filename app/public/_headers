# Hashed build assets never change — cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Per-page Quran data/fonts/images — every dataset/index URL is now
# content-hashed (`?v=<hash>`, see data-pipeline/src/lib/manifest.mjs), so a
# cache hit is never stale by construction: safe to cache forever, same as
# hashed JS/CSS above. Per-page font files aren't hash-versioned but are
# treated as immutable by convention (their content never changes for a given
# URL).
/data/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Landing-page demo screencasts (see /download) and their poster frames —
# unhashed filenames but content only ever changes by replacing the file
# wholesale (re-running the screencast scripts), same convention as fonts.
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# The two manifest files are the trust anchor those hashes are checked
# against — they are NOT content-hashed (a hash can't describe itself) and
# must always be revalidated, never served stale from any HTTP cache. Listed
# after the wildcard rules above so they override Cache-Control for these
# exact paths.
/data/manifest.json
  Cache-Control: no-cache
/fonts/manifest.json
  Cache-Control: no-cache

# The shell must always be fresh so new deploys are picked up.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
