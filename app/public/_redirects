# Data/font/image paths must 404 for real when a file is missing, not
# silently fall back to the app shell with a 200 — a 200-HTML response for a
# JSON request breaks JSON.parse with a confusing error, and would otherwise
# get cached as if it were legitimate data by the SW's StaleWhileRevalidate
# route for these prefixes.
/data/*    /index.html    404
/fonts/*   /index.html    404
/img/*     /index.html    404

# SPA fallback: every other unmatched path serves the app shell (client-side router).
/*    /index.html    200
