    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.2",
