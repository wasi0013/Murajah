{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data": "node ../data-pipeline/src/build.mjs",
    "predev": "npm run data",
    "prebuild": "npm run data",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
