# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Test artifacts
/test-results/
/playwright-report/
/coverage/
/.lighthouseci/
# Regenerated by tests/e2e/global-setup.ts on every run.
/tests/e2e/.auth/

# Generated by data-pipeline (regenerated on prebuild/predev)
/public/data/
# Fonts (144MB) are generated by `assets:build` in CI — too large to commit.
/public/fonts/
# Mushaf WebP (~68MB) IS committed (decision 3b.0.4): expensive to regenerate
# (needs cwebp + the 611MB source PNGs), rarely changes, and lets the static
# Pages deploy serve it with no build-time tooling. Keep other /public/img/* out.
/public/img/*
!/public/img/mushaf/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
